[node name="VolumePanel" type="VBoxContainer" parent="Overlay/Menu/Panel"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 24

[node name="VolumeHeader" type="HBoxContainer" parent="Overlay/Menu/Panel/VolumePanel"]
layout_mode = 2

[node name="VolumeLabel" type="Label" parent="Overlay/Menu/Panel/VolumePanel/VolumeHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 46
text = "总音量"

[node name="VolumeValue" type="Label" parent="Overlay/Menu/Panel/VolumePanel/VolumeHeader"]
unique_name_in_owner = true
layout_mode = 2
