[sub_resource type="ButtonGroup" id="ButtonGroup_tabs"]

[node name="Level Sense" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_level_sense")

[node name="Overlay" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("Theme_level_sense")

[node name="Menu" type="VBoxContainer" parent="Overlay"]
custom_minimum_size = Vector2(960, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="Toolbar" type="HBoxContainer" parent="Overlay/Menu"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="VolumeTab" type="Button" parent="Overlay/Menu/Toolbar"]
custom_minimum_size = Vector2(0, 78)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_tabs")
text = "音量"

[node name="SaveTab" type="Button" parent="Overlay/Menu/Toolbar"]
