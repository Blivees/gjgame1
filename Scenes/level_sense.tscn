theme_override_constants/outline_size = 7
theme_override_font_sizes/font_size = 26
text = "继续游戏"

[connection signal="pressed" from="Overlay/Menu/Toolbar/VolumeTab" to="." method="_on_volume_tab_pressed"]
[connection signal="pressed" from="Overlay/Menu/Toolbar/SaveTab" to="." method="_on_save_tab_pressed"]
[connection signal="pressed" from="Overlay/Menu/Toolbar/ReturnButton" to="." method="_on_return_pressed"]
[connection signal="pressed" from="Overlay/Menu/Panel/SavePanel/SaveButton" to="." method="_on_save_pressed"]
[connection signal="value_changed" from="Overlay/Menu/Panel/VolumePanel/VolumeSlider" to="." method="_on_volume_changed"]
