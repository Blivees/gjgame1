layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "返回主菜单"

[node name="Panel" type="PanelContainer" parent="Overlay/Menu"]
custom_minimum_size = Vector2(0, 282)
layout_mode = 2

[node name="SavePanel" type="VBoxContainer" parent="Overlay/Menu/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="LevelName" type="Label" parent="Overlay/Menu/Panel/SavePanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 46
text = "Level One"

[node name="SaveStatus" type="Label" parent="Overlay/Menu/Panel/SavePanel"]
unique_name_in_owner = true
layout_mode = 2
